# Echo Duel milestone 1: keyboard + sound + VGA.
set_global_assignment -name FAMILY "Cyclone V"
set_global_assignment -name DEVICE 5CSEMA5F31C6
set_global_assignment -name TOP_LEVEL_ENTITY echo_duel_m1
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name SDC_FILE echo_duel_m1.sdc
set_global_assignment -name MIF_FILE MIF/black_160_9.mif
set_global_assignment -name VERILOG_FILE echo_duel_m1.v
set_global_assignment -name VERILOG_FILE "../Milestone 1/Saajan/note_decoder.v"
